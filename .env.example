# Wholesale AI — server-side secrets ONLY (never commit real values).
# HighLevel Private Integration token (per sub-account):
# GHL sub-account -> Settings -> Private Integrations -> create "Wholesale AI"
# Scopes (minimum): contacts.readonly, conversations.readonly, conversations.write,
# opportunities.readonly, locations.readonly
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Gmail (later milestone): your own Google Cloud OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# App storage: Postgres connection string (production: Supabase transaction
# pooler, port 6543). Leave unset for local dev — the store then uses
# data/store.json.
DATABASE_URL=
# Listing data via Apify (paste-a-link autopopulate + Redfin search).
# Token: Apify Console -> Settings -> API & Integrations. Actor IDs are
# optional overrides; the defaults are maxcopell/zillow-detail-scraper and
# tri_angle/redfin-search. The same Actors are reachable by agents through
# Apify MCP (mcp.apify.com); the app itself uses the REST run-sync endpoint.
APIFY_TOKEN=
APIFY_ZILLOW_ACTOR=
APIFY_REDFIN_ACTOR=
# RentCast — used ONLY to verify deals that are already under contract
# (the server checks HighLevel before calling). Never used for shopping
# or general enrichment.
RENTCAST_API_KEY=
# AI providers (optional, independently configurable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# AI offer-drafting cost controls (lib/ai/draft.ts): the drafting model, the
# escalation model for modeled fees >= $25,000, and the monthly budget cap
# in USD (default 25). Drafts only — nothing sends from the AI path.
AI_DRAFT_MODEL=claude-haiku-4-5
AI_ESCALATION_MODEL=claude-sonnet-5
AI_MONTHLY_BUDGET_USD=25
# Blast background driver: when set, POST /api/blast/tick requires this
# value in the x-blast-secret header. Production should always set it.
BLAST_TICK_SECRET=
